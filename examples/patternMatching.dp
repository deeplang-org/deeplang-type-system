type Maybe [
  Nothing,
  Just(value: I32)
]

type Point {
  x : I32,
  y : I32
}

fun main(x: Maybe) {
  match(x) {
    _ => { return (); }
    a : Maybe => { return (); }
    Nothing => { return (); }
    Just(inner) => { return (); }
  }
}

fun testTuple(x: (I32, Bool, I32)) {
  match(x) {
    (a, b, c) => { return (); }
    (a, b: Bool, c): (I32, Bool, I32) => { return (); }
    _ => { return (); }
  }
}

fun testStruct(x: Point) {
  match(x) {
    Point { x : _, y : _ } => { return (); }
    Point { x : 7, y : _ } => { return (); }
    Point { x : 7, y : _ } : Point as p => { return (); }
    _ => { return (); }
  }
}

fun testLiteral(x: I32) {
  match(x) {
    7 => { return (); }
    _ => { return (); }
  }
}
