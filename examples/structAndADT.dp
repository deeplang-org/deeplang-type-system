type Shape [
  Rectangle(width : I32, height : I32),
  Circle(radius : I32),
  Nothing
]

type Point {
  x : I32,
  y : I32
}

type Color {
  r : I32,
  g : I32,
  b : I32
}

type ColoredPoint {
  as position : Point,
  color : Color
}

fun main(x: Char) {}

let tsr: F64 = 2.72;
let shape: Shape = Circle(12);
let point: Point = Point { x : 1, y : 2 };
let colored: ColoredPoint = ColoredPoint { position : point, color : Color { r : 255, g : 0, b : 0 } };
