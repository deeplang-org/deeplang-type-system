interface Quack {
  fun quack() -> ();
}

type Duck [
  Mallard,
  RubberDuck
]

impl Quack for Duck {
  fun quack() -> () {
    let dummy : I32 = 1;
  }
}

type Bird [
  Sparrow,
  Penguin
]

impl Quack for Bird {
  fun quack() -> () {
    let dummy : I32 = 2;
  }
}

fun sound(animal: Quack) -> () {
  animal.quack();
}

fun main() -> () {
  let duck: Duck = Mallard;
  let bird: Bird = Sparrow;

  sound(duck);
  sound(bird);
}
