fun main() {
  let mut f : Bool;
  f = true;

  // if/else chain
  if (f) {
    let dummy1 : I32 = 1;
  } else if (true) {
    let dummy2 : I32 = 2;
    if (false) {
      let dummy3 : I32 = 3;
    } else if (f) {
      let dummy4 : I32 = 4;
    }
  } else {
    let dummy5 : I32 = 5;
  }

  // while loop
  let mut a : I32 = 0;
  while (a < 3) {
    a = a + 1;
  }

  // C-style for loop
  for (let mut i : I32 = 0; i < 5; ++i) {
    let dummy6 : I32 = i;
  }

  // while loop with break and continue
  let mut counter : I32 = 0;
  while (true) {
    if (counter > 5) {
      break;
    } else {
      counter = counter + 1;
      continue;
    }
  }
}

// for-in loop with simple pattern
fun testForIn(arr : [I32; 3]) {
  for (item : I32 in arr) {
    let dummy7 : I32 = item;
  }
}

// for-in loop with tuple pattern
fun testForInTuple(pairs : [(I32, Bool); 2]) {
  for ((k, v) in pairs) {
    let dummy8 : I32 = k;
    let dummy9 : Bool = v;
  }
}
