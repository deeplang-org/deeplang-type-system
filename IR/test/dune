(executable
 (name ConversionTest)
 (libraries IR Syntax Semantics)
 (preprocess (pps ppx_deriving.show))
 (modules ConversionTest))

(executable
 (name WasmGenTest)
 (libraries IR Syntax Semantics)
 (preprocess (pps ppx_deriving.show))
 (modules WasmGenTest))

(rule
 (action
  (with-stdout-to test.output
   (run ./ConversionTest.exe %{test_sources})))
 (deps
  (:test_sources
   (glob_files *.dp))))

(rule
 (alias runtest)
 (action (diff test.expected test.output)))

(rule
 (action
  (with-stdout-to wasmgen_test.output
   (run ./WasmGenTest.exe %{test_sources})))
 (deps
  (:test_sources
   (glob_files *.dp))))

(rule
 (alias runtest)
 (action (diff wasmgen_test.expected wasmgen_test.output)))
